{
  assignees: ["corrupt952"],
  reviewers: ["corrupt952"],

  extends: [
    "config:best-practices",

    // https://docs.renovatebot.com/presets-default/
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",

    // Keep biome.json $schema version in sync with @biomejs/biome package
    "customManagers:biomeVersions",
  ],

  // https://docs.renovatebot.com/key-concepts/scheduling/#setting-your-timezone
  timezone: "Asia/Tokyo",

  // https://docs.renovatebot.com/key-concepts/scheduling/
  // Full-day Monday window. The built-in `schedule:weekly` / `schedule:earlyMondays`
  // only allows PRs in a narrow early-morning window, which the Mend-hosted
  // scheduler routinely misses and silently skips for a week
  // (renovatebot/renovate#35532).
  schedule: ["on monday"],

  // Automerge
  // automergeStrategy is intentionally omitted: it is silently ignored when
  // platformAutomerge=true (renovatebot/renovate#41177). GitHub repo merge
  // settings control the actual strategy instead.
  platformAutomerge: true,

  // Package rules
  packageRules: [
    {
      matchUpdateTypes: ["minor", "patch", "pin"],
      automerge: true,
    },

    // https://docs.renovatebot.com/key-concepts/minimum-release-age/
    // config:best-practices only ages npm (security:minimumReleaseAgeNpm,
    // 3 days). This gives version updates in every other ecosystem the same
    // cooldown before automerge; they would otherwise be automerged with no
    // cooldown at all. PRs still open immediately (prCreation=immediate); the
    // cooldown only holds the renovate/stability-days check pending.
    //
    // Scoped to version updates on purpose. The other update types carry no
    // usable release timestamp (lockFileMaintenance, pin, replacement, bump,
    // rollback, and digest/pinDigest on registries without one), and under the
    // default minimumReleaseAgeBehaviour=timestamp-required the branch-level
    // stability check then stays pending forever instead of ageing out:
    //
    //   https://github.com/renovatebot/renovate/issues/45236
    //
    // This mirrors the carve-outs Renovate's own security:minimumReleaseAge*
    // presets apply to npm. matchDatasources negation is documented under
    // https://docs.renovatebot.com/string-pattern-matching/#negative-matching
    // and a rule with no datasource (lockFileMaintenance) never matches it.
    {
      matchDatasources: ["!npm"],
      matchUpdateTypes: ["major", "minor", "patch"],
      minimumReleaseAge: "3 days",
    },

    {
      groupName: "cloudflare workers-sdk",
      matchSourceUrls: ["https://github.com/cloudflare/workers-sdk"],
      // https://docs.renovatebot.com/configuration-options/#minimumreleaseage
      // config:best-practices (via security:minimumReleaseAgeNpm) sets 3 days
      // for all npm packages; shortened here for the fast-moving workers-sdk
      // monorepo (wrangler, miniflare, etc).
      minimumReleaseAge: "1 day",
    },
  ],
}
